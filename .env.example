# Copy this file to .env and fill in the values. Restart the service after changes.
PORT=3000
HOST=127.0.0.1
# Public address of the site (used for canonical links, sitemap and robots.txt)
SITE_URL=https://ir.xmax.com
# Where admin content and uploaded files are stored (must be writable by the service user; back it up)
STORAGE_DIR=/var/lib/xmax-ir
# Admin page password (long and random)
ADMIN_PASSWORD=
# Market data API key (Finnhub) - a commercial licence is required for public display
QUOTE_API_KEY=
# Identifies the company to the SEC when reading EDGAR data (required by the SEC)
SEC_UA=XMax Inc. Investor Relations IR@XMax.com
# Largest file the admin page may upload, in MB (keep Nginx client_max_body_size a little larger)
UPLOAD_MAX_MB=200
# Optional: GlobeNewswire full-text RSS/ATOM feed for the company, if one is provided
GNW_RSS=
# Total time allowed for one upload (seconds); Nginx timeouts must allow this
UPLOAD_TIMEOUT_SECONDS=900
