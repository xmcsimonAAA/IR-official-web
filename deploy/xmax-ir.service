# systemd service for the XMax IR website
# Install: sudo cp deploy/xmax-ir.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now xmax-ir
[Unit]
Description=XMax IR website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xmaxir
Group=xmaxir
WorkingDirectory=/opt/xmax-ir
ExecStart=/usr/bin/env node /opt/xmax-ir/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
TimeoutStopSec=20
ReadWritePaths=/var/lib/xmax-ir

[Install]
WantedBy=multi-user.target
